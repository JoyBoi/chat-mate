{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".(e2e-spec|integration.spec).ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@chat-mate/types$": "<rootDir>/mocks/types.mock.ts",
    "^@chat-mate/utils$": "<rootDir>/mocks/utils.mock.ts"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1,
  "forceExit": true,
  "detectOpenHandles": true
}
