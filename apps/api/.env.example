# Database
DATABASE_URL="postgresql://username:password@localhost:5432/chatmate?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/chatmate?schema=public"

# Supabase
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# JWT
JWT_SECRET="jwt-secre-key"
JWT_EXPIRES_IN="43200s"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Valkey (Redis-compatible)
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_PASSWORD=""
VALKEY_DB=0

# BullMQ
BULLMQ_REDIS_URL="redis://localhost:6379"

# Job Processing
JOB_META_SECRET="job-meta-secret-key"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key-here"