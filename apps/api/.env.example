# Database
DATABASE_URL="postgresql://username:password@localhost:5432/chatmate?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/chatmate?schema=public"

# Supabase
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# JWT
JWT_SECRET="jwt-secre-key"
JWT_EXPIRES_IN="43200s"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Valkey (Redis-compatible)
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_PASSWORD=""
VALKEY_DB=0

# Valkey Production Settings
VALKEY_MAX_MEMORY="256mb"
VALKEY_CONNECT_TIMEOUT="10000"
VALKEY_COMMAND_TIMEOUT="5000"
VALKEY_RETRY_DELAY="100"
VALKEY_MAX_LOADING_TIMEOUT="5000"
VALKEY_SAVE_POLICY="3600 1 300 100 60 10000"
VALKEY_MAX_CLIENTS="10000"
VALKEY_TCP_KEEPALIVE="30"

# Valkey TLS (for production)
VALKEY_TLS_ENABLED="false"
VALKEY_TLS_CERT=""
VALKEY_TLS_KEY=""
VALKEY_TLS_CA=""

# BullMQ
BULLMQ_REDIS_URL="redis://localhost:6379"

# BullMQ Dashboard
BULLMQ_DASHBOARD_ENABLED="true"
BULLMQ_DASHBOARD_PATH="/admin/queues"
BULLMQ_DASHBOARD_AUTH="false"
BULLMQ_DASHBOARD_USERNAME="admin"
BULLMQ_DASHBOARD_PASSWORD="password"

# Job Processing
JOB_META_SECRET="job-meta-secret-key"

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"