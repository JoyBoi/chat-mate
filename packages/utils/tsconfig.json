{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@chat-mate/types": ["../types/src"]
    }
  },
  "include": ["src/**/*", "vitest.setup.ts"],
  "exclude": ["dist", "node_modules"]
}
